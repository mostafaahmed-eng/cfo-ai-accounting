# AI CFO Manager - Environment Variables Template
# Copy this file to .env and fill in the values
#
# Generate secrets with:
#   SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=cfo_db

# MinIO object storage (internal to the production stack; no public ports)
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_STRONG_PASSWORD

# Backend
SECRET_KEY=CHANGE_ME_RUN_python_command_to_generate
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=CHANGE_ME_RUN_fernet_generate_key_command
# Comma-separated emails of platform administrators. Only these users may change
# the GLOBAL Telegram bot configuration (PUT /integrations/telegram/bot-config).
# Leave empty to deny everyone. Per-company roles never grant this.
PLATFORM_ADMIN_EMAILS=
# Comma-separated origins allowed to call the API. No wildcard in production.
# For IP-based access (no domain), set this to http://<VPS_IP>:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Public base URL used by the Telegram webhook setup script
PUBLIC_BASE_URL=http://localhost:8080
# Send Strict-Transport-Security (forces the browser to HTTPS for this host on ALL ports).
# Keep false while the site is plain HTTP / IP-based / Cloudflare on a non-HTTPS proxy
# port (e.g. 8080) — HSTS there silently breaks the site. Set true only once real
# end-to-end HTTPS (domain + SSL) exists.
HSTS_ENABLED=false

# AI Extraction (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI cost guard: max AI-dispatch requests (extract / extract-async / text intake /
# retry / upload) per company per hour. 60/hour is a hard per-tenant cap on AI
# cost while leaving legitimate receipt intake headroom. Set lower if desired.
RATE_LIMIT_AI=60/hour

# Automatic exchange-rate lookup (free; no API key required)
FX_PROVIDER_BASE_URL=https://open.er-api.com/v6
FX_PROVIDER_TIMEOUT_SECONDS=10
# Current rates may be used only for today or the prior 2 calendar days.
FX_AUTO_FETCH_MAX_AGE_DAYS=2

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_EDIT_TTL_MINUTES=15
TELEGRAM_BOT_USERNAME=
# Long-polling mode (no public HTTPS endpoint required). Enable when the bot
# cannot receive webhooks (e.g. HTTP-only / IP-only deployment). The worker
# forwards each update to the internal webhook endpoint of the backend.
# Requires TELEGRAM_WEBHOOK_SECRET and a token without an active webhook
# (delete it first with: curl https://api.telegram.org/bot<TOKEN>/deleteWebhook).
TELEGRAM_POLLING_INTERNAL_WEBHOOK_URL=http://backend:8000/api/v1/telegram/webhook
# File used to persist the getUpdates offset between restarts.
TELEGRAM_POLLING_OFFSET_FILE=/tmp/telegram_poll_offset

# Object storage. In dev, these are hard-coded by docker-compose.yml for local
# MinIO. In production, docker-compose.prod.yml derives S3 credentials from
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD and uses the internal MinIO endpoint.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=cfo-manager-receipts-local
S3_REGION=us-east-1

# Frontend
# Same-origin by default: leave empty so the browser calls /api/v1 on the same
# host/port nginx serves. The frontend is built at deploy time; if you serve the
# API from a DIFFERENT origin than the frontend, set this to the full API base
# URL including the /api/v1 suffix (e.g. https://cfo.example.com/api/v1).
# NOTE: never set this to localhost on the server — the browser would call its
# OWN localhost. In local development the dev compose already sets it to
# http://localhost:8000/api/v1.
NEXT_PUBLIC_API_BASE_URL=

# Nginx entrypoint port (plain HTTP until a domain/SSL exists). All external
# traffic goes through this single port; set it to the port you open on the
# firewall (e.g. 8080). Do NOT expose 8000/3000 directly.
NGINX_PORT=8080

# HTTPS/TLS (optional). Default nginx config serves plain HTTP and requires no
# certificates — local development and IP-only deployments need nothing here.
# To enable HTTPS set:
#   NGINX_CONF_FILE=./nginx/nginx.ssl.conf
#   NGINX_CERT_DIR=/etc/letsencrypt/live/<your-domain>
# and open TCP 443 in the firewall. NGINX_CERT_DIR must contain fullchain.pem
# and privkey.pem. Example with Let's Encrypt (domain DNS must already point to
# this server):
#   sudo apt install -y certbot
#   sudo certbot certonly --standalone -d <your-domain> --agree-tos -m you@example.com
#   (stop the stack first, or use: sudo certbot certonly --nginx -d <your-domain>)
#   NGINX_CONF_FILE=./nginx/nginx.ssl.conf
#   NGINX_CERT_DIR=/etc/letsencrypt/live/<your-domain>
#   NGINX_HTTPS_PORT=443
NGINX_CONF_FILE=./nginx/nginx.conf
NGINX_CERT_DIR=./nginx/certs
NGINX_HTTPS_PORT=443

# Upload limits
MAX_UPLOAD_SIZE=10485760

# SQLAlchemy async engine pool tuning. Per-process caps keep total connections
# under the Postgres default max_connections=100. Production compose overrides
# these per service (backend: 4 uvicorn workers x (5 + 5) = 40, leaving
# headroom for the celery worker, telegram-poll and alembic).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Ping the connection before handing it out (cheap, avoids serving dead
# connections after network blips / Postgres restarts).
DB_POOL_PRE_PING=true
