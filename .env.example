# AI CFO Manager - Environment Variables Template
# Copy this file to .env and fill in the values
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=cfo_db

# Backend
SECRET_KEY=CHANGE_ME_RUN_python_command_to_generate
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=CHANGE_ME_RUN_python_command_to_generate

# AI Extraction (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# S3 Object Storage (optional)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=cfo-documents
S3_REGION=auto

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1

# Upload limits
MAX_UPLOAD_SIZE=10485760
