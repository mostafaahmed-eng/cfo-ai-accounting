# AI CFO Manager - Environment Variables Template
# Copy this file to .env and fill in the values
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=cfo_db

# Backend
SECRET_KEY=CHANGE_ME_RUN_python_command_to_generate
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=CHANGE_ME_RUN_python_command_to_generate

# AI Extraction (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Automatic exchange-rate lookup (free; no API key required)
FX_PROVIDER_BASE_URL=https://open.er-api.com/v6
FX_PROVIDER_TIMEOUT_SECONDS=10
# Current rates may be used only for today or the prior 2 calendar days.
FX_AUTO_FETCH_MAX_AGE_DAYS=2

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Local MinIO object storage used by Docker Compose.
# These credentials are intentionally local-only. Never reuse them in staging,
# production, or a real cloud deployment.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=cfo-manager-receipts-local
S3_REGION=us-east-1

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1

# Upload limits
MAX_UPLOAD_SIZE=10485760
