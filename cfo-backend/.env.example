# ── App / Auth ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_RUN_this_python_command_to_generate
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated origins allowed to call the API. No wildcard in production.
# Legacy name ALLOWED_ORIGINS still works as an alias.
# For IP-based access (no domain): http://<VPS_IP>:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ── Database ────────────────────────────────────────────────
# In Docker Compose, the backend service overrides this to
# postgresql+asyncpg://postgres:postgres@postgres:5432/cfo_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cfo_db

# ── Redis / Celery ──────────────────────────────────────────
# In Docker Compose, the backend service overrides this to
# redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── OpenRouter AI ───────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Exchange rates (free provider; no API key required) ─────
FX_PROVIDER_BASE_URL=https://open.er-api.com/v6
FX_PROVIDER_TIMEOUT_SECONDS=10
# Current rates may be used only for today or the prior 2 calendar days.
FX_AUTO_FETCH_MAX_AGE_DAYS=2

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Required unless ENVIRONMENT=development and the explicit local-only bypass below is true.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_EDIT_TTL_MINUTES=15
TELEGRAM_BOT_USERNAME=
TELEGRAM_PAIRING_TTL_MINUTES=15
# Local development only. Never enable in staging or production.
TELEGRAM_ALLOW_INSECURE_LOCAL_WEBHOOK=false
# Long-polling mode (no public HTTPS endpoint required). Enable when the bot
# cannot receive webhooks (e.g. HTTP-only / IP-only deployment). The worker
# forwards each update to the internal webhook endpoint of the backend.
# Requires TELEGRAM_WEBHOOK_SECRET and a token without an active webhook
# (delete it first with: curl https://api.telegram.org/bot<TOKEN>/deleteWebhook).
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLLING_INTERNAL_WEBHOOK_URL=http://backend:8000/api/v1/telegram/webhook
TELEGRAM_POLLING_OFFSET_FILE=/tmp/telegram_poll_offset
# Public base URL used by the one-command webhook setup script
# (python -m app.scripts.telegram_setup).
# For IP-based access (no domain): http://<VPS_IP>:8080
PUBLIC_BASE_URL=http://localhost:8080

# ── Runtime environment ─────────────────────────────────────
ENVIRONMENT=development
# Send Strict-Transport-Security (forces the browser to HTTPS for this host on ALL ports).
# Keep false while the site is plain HTTP / IP-based / Cloudflare on a non-HTTPS proxy
# port (e.g. 8080) — HSTS there silently breaks the site. Set true only once real
# end-to-end HTTPS (domain + SSL) exists.
HSTS_ENABLED=false

# ── Object Storage (local MinIO via Docker Compose) ─────────
# These credentials are intentionally local-only. Never reuse them in staging,
# production, or a real cloud deployment.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=cfo-manager-receipts-local
S3_REGION=us-east-1

# ── Encryption ──────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_RUN_fernet_generate_key_command

# ── Upload Limits (optional, shown for reference) ───────────
# MAX_UPLOAD_SIZE=10485760
# MAX_PDF_PAGES=20
# ALLOWED_MIME_TYPES=["image/jpeg","image/png","application/pdf"]

# ── Rate limiting (optional, shown for reference) ───────────
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_WEBHOOK=30/minute
