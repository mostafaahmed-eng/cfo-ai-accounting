# ── App / Auth ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_RUN_this_python_command_to_generate
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ────────────────────────────────────────────────
# In Docker Compose, the backend service overrides this to
# postgresql+asyncpg://postgres:postgres@postgres:5432/cfo_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cfo_db

# ── Redis / Celery ──────────────────────────────────────────
# In Docker Compose, the backend service overrides this to
# redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── OpenRouter AI ───────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# ── Object Storage (S3 / Cloudflare R2) ─────────────────────
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=cfo-documents
S3_REGION=auto

# ── Encryption ──────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_RUN_this_python_command_to_generate

# ── Upload Limits (optional, shown for reference) ───────────
# MAX_UPLOAD_SIZE=10485760
# ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp","application/pdf"]
